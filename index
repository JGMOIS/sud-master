  const ns = body.querySelector('#msSt').value;
  prop.status = ns;
  if (ns === 'adjudicado'){
    prop.dataAdjudicacao = todayISO();
    prop.valorAdjudicado = Number(body.querySelector('#msVA').value);
  } else if (ns === 'por_aprovar'){
    prop.dataEnvio = prop.dataEnvio || todayISO();
  }
  Store.save();
  toast('Status atualizado');
  ViewPropostaEditor($('#view'), prop.id);
}

function novaVersao(prop){
  // Find next version
  const sames = Store.data.propostas.filter(p=>p.numero===prop.numero);
  const maxV = Math.max(...sames.map(p=> Number(String(p.versao).slice(1))||0));
  if (maxV >= 99){ toast('Limite de versões atingido (V99)'); return; }
  const novo = JSON.parse(JSON.stringify(prop));
  novo.id = uid();
  novo.versao = 'V' + (maxV+1);
  novo.status = 'por_enviar';
  novo.dataEnvio = null; novo.dataAdjudicacao = null;
  novo.valorAdjudicado = null;
  // Renew ids
  for (const c of novo.capitulos){
    c.id = uid();
    for (const s of c.subcapitulos){ s.id = uid(); for (const a of s.atividades){ a.id = uid(); a.materiais.forEach(m=>m.id=uid()); a.subs.forEach(x=>x.id=uid()); } }
    for (const a of (c.atividadesDiretas||[])){ a.id = uid(); a.materiais.forEach(m=>m.id=uid()); }
  }
  Store.data.propostas.unshift(novo);
  Store.save();
  toast(`Criada ${novo.versao}`);
  location.hash = `#propostas/${novo.id}`;
}

