    };
    // Import CRM seed (clientes + propostas list — sem detalhe ainda)
    const crmSeed = SEED.crm || [];
    const clienteByName = new Map();
    crmSeed.forEach(p=>{
      const cliNome = (p.Cliente||'').trim();
      if (cliNome && !clienteByName.has(cliNome)){
        const cli = {
          id: uid(), nome: cliNome, contacto:'', email:'', telefone:'',
