      <input class="btn" id="filtroTexto" placeholder="Pesquisar nº, cliente, obra…" style="background:#fff;flex:1;max-width:340px">
      <select class="btn" id="filtroStatus" style="background:#fff">
        <option value="">Todos os status</option>
        <option value="por_enviar">Por enviar</option>
        <option value="por_aprovar">Por aprovar</option>
        <option value="adjudicado">Adjudicado</option>
        <option value="cancelado">Cancelado</option>
      </select>
      <label style="display:inline-flex;align-items:center;gap:5px;font-size:12px;background:#fff;padding:7px 10px;border:1px solid #CFD3DC;border-radius:6px"><input type="checkbox" id="filtroFlat"> todas as versões</label>
      <select class="btn" id="filtroAno" style="background:#fff">
        <option value="">Todos os anos</option>
        ${[...new Set(d.propostas.map(p=>String(p.numero).slice(0,2)))].sort().reverse().map(a=>`<option value="${a}">20${a}</option>`).join('')}
      </select>
      <div class="spacer"></div>
      <span class="muted" id="contagem"></span>
    </div>
    <div class="panel"><div class="panel-body tight">
      <table class="tbl"><thead><tr>
        <th>Nº</th><th>Versão</th><th>Cliente</th><th>Obra</th><th>Morada</th>
        <th>Status</th><th>Data</th><th class="num">Valor</th><th></th>
      </tr></thead><tbody id="rows"></tbody></table>
    </div></div>`;
  function render(){
    const q = $('#filtroTexto').value.toLowerCase().trim();
    const st = $('#filtroStatus').value;
    const ano = $('#filtroAno').value;
    const showAll = $('#filtroFlat')?.checked;
    
    let list = d.propostas
      .filter(p=>!q || (String(p.numero)+' '+p.clienteNome+' '+p.obraNome+' '+p.morada).toLowerCase().includes(q))
      .filter(p=>!ano || String(p.numero).slice(0,2)===ano);
    
    if (showAll){
      list = list.filter(p=>!st || p.status===st)
        .sort((a,b)=> b.numero - a.numero || (b.versao>a.versao?1:-1));
      $('#contagem').textContent = `${list.length} versões (vista plana)`;
      $('#rows').innerHTML = list.length ? list.map(p=>renderPropostaRow(p, true)).join('') : `<tr class="no-hover"><td colspan="9"><div class="empty"><div class="icon">📋</div><h3>Sem resultados</h3></div></td></tr>`;
      return;
    }
    
    // Group by obra (numero)
    const byObra = {};
    for (const p of list){
      if (!byObra[p.numero]) byObra[p.numero] = [];
      byObra[p.numero].push(p);
    }
    // Pick "actual" version per obra: latest non-cancelled, or latest if all cancelled
    const obras = [];
    for (const [num, versoes] of Object.entries(byObra)){
      versoes.sort((a,b)=> (b.versao>a.versao?1:-1));
      const actual = versoes.find(v=>v.status!=='cancelado') || versoes[0];
      obras.push({numero: Number(num), actual, versoes});
    }
    obras.sort((a,b)=> b.numero - a.numero);
    
    // Apply status filter on the actual version
    const filtered = obras.filter(o => !st || o.actual.status === st);
    
    $('#contagem').textContent = `${filtered.length} obras de ${obras.length} (${list.length} versões totais)`;
    $('#rows').innerHTML = filtered.length ? filtered.map(o=>{
      const p = o.actual;
      const moreVersions = o.versoes.length > 1;
      const expandedKey = `obra_exp_${o.numero}`;
      const isExpanded = window['__expanded_'+o.numero];
      let html = `
        <tr data-obra="${o.numero}" ${moreVersions?'data-toggle="1"':''} class="obra-row">
          <td>${moreVersions ? `<span class="tag" style="cursor:pointer">${isExpanded?'▾':'▸'} ${o.versoes.length}v</span>` : ''} <b>${p.numero}</b></td>
          <td>${p.versao}</td>
          <td>${escapeHTML(p.clienteNome||'—')}</td>
          <td>${escapeHTML(p.obraNome||'—')}</td>
          <td class="muted">${escapeHTML(p.morada||'')}</td>
          <td><span class="status-pill status-${p.status}">${labelStatus(p.status)}</span></td>
          <td class="muted">${p.dataEnvio||'—'}</td>
          <td class="num">${p.valorTotal?fmtEUR(p.valorTotal):'<span class="muted">—</span>'}</td>
          <td>${p._avisoFicheiro?'<span class="tag" title="Ficheiro não encontrado">⚠</span>':''}${p._seedOnly?'<span class="tag">só ficha</span>':''}</td>
        </tr>`;
      if (isExpanded && moreVersions){
        for (const v of o.versoes){
          html += `<tr data-go="#propostas/${v.id}" class="version-row" style="background:#FAFBFC">
            <td style="padding-left:30px" colspan="2"><span class="muted">${v.versao}</span></td>
            <td colspan="3" class="muted">${escapeHTML(v.obraNome||'')}</td>
            <td><span class="status-pill status-${v.status}">${labelStatus(v.status)}</span></td>
            <td class="muted">${v.dataEnvio||'—'}</td>
            <td class="num">${v.valorTotal?fmtEUR(v.valorTotal):'—'}</td>
            <td></td>
          </tr>`;
        }
      }
      return html;
    }).join('') : `<tr class="no-hover"><td colspan="9"><div class="empty"><div class="icon">📋</div><h3>Sem resultados</h3></div></td></tr>`;
  }
  
  function renderPropostaRow(p, flat){
    return `<tr data-go="#propostas/${p.id}">
      <td><b>${p.numero}</b></td>
      <td>${p.versao}</td>
      <td>${escapeHTML(p.clienteNome||'—')}</td>
      <td>${escapeHTML(p.obraNome||'—')}</td>
      <td class="muted">${escapeHTML(p.morada||'')}</td>
      <td><span class="status-pill status-${p.status}">${labelStatus(p.status)}</span></td>
      <td class="muted">${p.dataEnvio||'—'}</td>
      <td class="num">${p.valorTotal?fmtEUR(p.valorTotal):'<span class="muted">—</span>'}</td>
      <td>${p._avisoFicheiro?'<span class="tag" title="Ficheiro não encontrado">⚠</span>':''}${p._seedOnly?'<span class="tag">só ficha</span>':''}</td>
    </tr>`;
  }
  $('#btnNova').onclick = ()=>novaProposta();
  ['#filtroTexto','#filtroStatus','#filtroAno','#filtroFlat'].forEach(s=> { const e=$(s); if(e) e.addEventListener('input', render); });
  view.addEventListener('click', e=>{
    const obraRow = e.target.closest('tr[data-obra][data-toggle]');
    if (obraRow){
      const num = obraRow.dataset.obra;
      window['__expanded_'+num] = !window['__expanded_'+num];
      render(); return;
    }
    const tr = e.target.closest('tr[data-go]');
    if (tr) location.hash = tr.dataset.go;
    else {
      const oneVersion = e.target.closest('tr[data-obra]:not([data-toggle])');
      if (oneVersion){
        // Find the only version of this obra and navigate
        const num = Number(oneVersion.dataset.obra);
        const p = Store.data.propostas.find(p=>p.numero===num);
        if (p) location.hash = `#propostas/${p.id}`;
      }
    }
  });
  render();
}

async function novaProposta(){
  const d = Store.data;
  const body = document.createElement('div');
  body.innerHTML = `
    <div class="form-grid">
      <div class="field full"><label>Cliente</label>
        <input id="ncCliente" list="ncClientesList" placeholder="Nome do cliente">
        <datalist id="ncClientesList">${d.clientes.map(c=>`<option value="${escapeHTML(c.nome)}">`).join('')}</datalist>
        <div class="hint">Se já existir, a morada e contactos preenchem automaticamente</div>
      </div>
