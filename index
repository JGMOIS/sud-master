        <div class="field"><label>NIF</label><input id="ce_nif" value="${escapeHTML(c.empresa.nif)}"></div>
        <div class="field"><label>Telefone</label><input id="ce_tel" value="${escapeHTML(c.empresa.telefone)}"></div>
        <div class="field full"><label>Email</label><input id="ce_email" value="${escapeHTML(c.empresa.email)}"></div>
      </div>
    </div></div>
    <div class="panel"><div class="panel-head"><h2>Numeração</h2></div>
    <div class="panel-body">
      <div class="form-grid cols-3">
        <div class="field"><label>Próximo nº</label><input id="cf_prox" type="number" value="${c.proximoNumero}"></div>
        <div class="field"><label>Custo Oficial (€/h)</label><input id="cf_co" type="number" step="0.01" value="${c.custoOficialH}"></div>
        <div class="field"><label>Custo Ajudante (€/h)</label><input id="cf_ca" type="number" step="0.01" value="${c.custoAjudanteH}"></div>
      </div>
    </div></div>
    <div class="panel"><div class="panel-head"><h2>Firebase (sincronização nuvem)</h2></div>
    <div class="panel-body">
      <p class="muted">Por agora os dados estão guardados localmente no browser. Para sincronizar com a sua equipa, configure o Firebase. <b>Veja o ficheiro FIREBASE_SETUP.md</b> ao lado deste app para o passo-a-passo. A configuração entra aqui:</p>
      <div class="field full"><label>Config Firebase (JSON)</label>
        <textarea id="cf_fb" rows="6" placeholder='{"apiKey":"…","authDomain":"…","projectId":"…",…}'>${escapeHTML(c.firebase?JSON.stringify(c.firebase, null, 2):'')}</textarea>
        <div class="hint">A integração ativa-se na próxima sessão (próxima entrega).</div>
      </div>
    </div></div>
    <div class="panel"><div class="panel-head"><h2>Sincronização Firebase</h2></div>
    <div class="panel-body">
      <p class="muted" id="fbStatusMsg">Configure Firebase abaixo e faça login para sincronizar com a nuvem.</p>
      <div class="row wrap">
        <button class="btn" id="cfFbLogin">🔐 Login</button>
        <button class="btn" id="cfFbLogout">🚪 Logout</button>
        <button class="btn btn-primary" id="cfFbPush">☁ ⬆ Enviar tudo para Firebase</button>
        <button class="btn" id="cfFbPull">☁ ⬇ Descarregar do Firebase</button>
      </div>
      <p class="muted" style="font-size:11px;margin-top:8px">⚠ Push sobrescreve o Firestore com o estado local. Pull sobrescreve o local com o do Firestore. Faça <b>Push</b> agora para subir as 301 propostas + BD pela primeira vez.</p>
    </div></div>
    <div class="panel"><div class="panel-head"><h2>Dados</h2></div>
    <div class="panel-body">
      <div class="row wrap">
        <button class="btn" id="cfExport">📤 Exportar tudo (JSON)</button>
        <button class="btn" id="cfImport">📥 Importar (JSON)</button>
        <button class="btn btn-danger" id="cfReset">⟲ Repor seed inicial</button>
      </div>
      <p class="muted" style="margin-top:10px">Exporte regularmente para backup. O reset apaga tudo no browser e re-importa as 272 propostas e a obra 2618 do CRM original.</p>
    </div></div>
    <div class="row" style="margin-top:14px"><div class="spacer"></div><button class="btn btn-primary" id="cfSalvar">Guardar Configurações</button></div>
  `;
  $('#cfFbLogin').onclick = ()=>{ if (!Firebase.ready){ Firebase.init().then(ok=>{ if(ok) showLoginOverlay(); }); } else showLoginOverlay(); };
  $('#cfFbLogout').onclick = async ()=>{ await Firebase.logout(); toast('Logout'); };
  $('#cfFbPush').onclick = ()=> Firebase.pushAll();
  $('#cfFbPull').onclick = ()=> Firebase.pullAll();
  $('#cfSalvar').onclick = ()=>{
    c.empresa.nome = $('#ce_nome').value;
    c.empresa.nif = $('#ce_nif').value;
    c.empresa.telefone = $('#ce_tel').value;
    c.empresa.email = $('#ce_email').value;
    c.proximoNumero = Number($('#cf_prox').value);
    c.custoOficialH = Number($('#cf_co').value);
    c.custoAjudanteH = Number($('#cf_ca').value);
    try { c.firebase = $('#cf_fb').value.trim() ? JSON.parse($('#cf_fb').value) : null; } catch { toast('Firebase config inválida'); return; }
    Store.save(); toast('Configurações guardadas');
  };
  $('#cfExport').onclick = ()=>{
    const blob = new Blob([JSON.stringify(Store.data, null, 2)], {type:'application/json'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = `construsud_backup_${todayISO()}.json`; a.click();
  };
  $('#cfImport').onclick = ()=>{
    const inp = document.createElement('input'); inp.type='file'; inp.accept='.json';
    inp.onchange = ()=>{
      const f = inp.files[0]; if (!f) return;
      const r = new FileReader(); r.onload = ()=>{
        try{ Store.data = JSON.parse(r.result); Store.save(); toast('Importado'); navigate(); }
        catch{ toast('Ficheiro inválido'); }
      };
      r.readAsText(f);
    };
    inp.click();
  };
  $('#cfReset').onclick = ()=>{
    if (!confirm('Repor seed inicial? Os dados locais serão substituídos.')) return;
    localStorage.removeItem(LS_KEY);
    Store.data = null; Store.load(); navigate(); toast('Reposto');
  };
}


/* ======================== FIREBASE ======================== */
const Firebase = {
  app: null, auth: null, db: null, user: null, ready: false,
  
  async init(){
    if (!window.fb){ console.warn('Firebase SDK ainda não carregou'); return false; }
    const cfg = Store.data?.config?.firebase;
    if (!cfg || !cfg.apiKey){ return false; }
    try {
      this.app = window.fb.initializeApp(cfg);
      this.auth = window.fb.getAuth(this.app);
      this.db = window.fb.getFirestore(this.app);
      this.ready = true;
      window.fb.onAuthStateChanged(this.auth, (u)=>{
        this.user = u;
        document.dispatchEvent(new Event('fb:auth'));
      });
      console.log('Firebase pronto.');
      return true;
    } catch(e){
      console.error('Firebase init falhou:', e);
      toast('Firebase: '+e.message);
      return false;
    }
  },
  
  async login(email, password){
    if (!this.auth) return false;
    try {
      const res = await window.fb.signInWithEmailAndPassword(this.auth, email, password);
      this.user = res.user;
      toast('Login efectuado: '+email);
      return true;
    } catch(e){
      // Try create user (first-time)
      if (e.code === 'auth/user-not-found' || e.code === 'auth/invalid-credential'){
        try {
          const res = await window.fb.createUserWithEmailAndPassword(this.auth, email, password);
          this.user = res.user;
          toast('Conta criada: '+email);
          return true;
        } catch(e2){
          toast('Login: '+e2.message);
          return false;
        }
      }
      toast('Login: '+e.message);
      return false;
    }
  },
  
  async logout(){
    if (this.auth) await window.fb.signOut(this.auth);
    this.user = null;
  },
  
  async pushAll(){
    if (!this.user || !this.db) { toast('Faça login primeiro'); return false; }
    const d = Store.data;
    const tot = d.propostas.length + d.clientes.length + d.bdAtividades.length + d.bdMateriais.length + d.equipas.length + (d.funcionarios?.length||0);
    toast(`A enviar ${tot} documentos...`);
    let n = 0;
    try {
      // Use multiple batched writes (Firestore limit: 500 ops/batch)
      const BATCH = 400;
      const writeCol = async (colName, items)=>{
        for (let i=0; i<items.length; i+=BATCH){
          const batch = window.fb.writeBatch(this.db);
          for (const item of items.slice(i, i+BATCH)){
            const ref = window.fb.doc(this.db, colName, item.id);
            batch.set(ref, item);
            n++;
          }
          await batch.commit();
        }
      };
      await writeCol('propostas', d.propostas);
      await writeCol('clientes', d.clientes);
      await writeCol('bdAtividades', d.bdAtividades);
      await writeCol('bdMateriais', d.bdMateriais);
      await writeCol('equipas', d.equipas);
      if (d.funcionarios) await writeCol('funcionarios', d.funcionarios.map(f=>({...f, id:f.id||uid()})));
      // Config
      await window.fb.setDoc(window.fb.doc(this.db, 'config', 'global'), d.config||{});
      toast(`✓ ${n} documentos enviados`);
      return true;
    } catch(e){
      console.error(e);
      toast('Erro: '+e.message);
      return false;
    }
  },
  
  async pullAll(){
    if (!this.user || !this.db) { toast('Faça login primeiro'); return false; }
    toast('A descarregar...');
    try {
      const cols = ['propostas','clientes','bdAtividades','bdMateriais','equipas','funcionarios'];
      for (const cn of cols){
        const snap = await window.fb.getDocs(window.fb.collection(this.db, cn));
        const items = [];
        snap.forEach(d=> items.push(d.data()));
        if (items.length) Store.data[cn] = items;
      }
      // Config
      const cfgSnap = await window.fb.getDoc(window.fb.doc(this.db, 'config', 'global'));
      if (cfgSnap.exists()) Store.data.config = {...Store.data.config, ...cfgSnap.data()};
      Store.save();
      toast(`✓ Descarregado: ${Store.data.propostas.length} propostas, ${Store.data.clientes.length} clientes`);
      navigate();
      return true;
    } catch(e){
      console.error(e);
      toast('Erro: '+e.message);
      return false;
    }
  }
};

/* ======================== LOGIN OVERLAY ======================== */
function showLoginOverlay(){
  if ($('#loginOverlay')) return;
  const div = document.createElement('div');
  div.id = 'loginOverlay';
  div.className = 'modal-back';
  div.innerHTML = `
    <div class="modal" style="width:380px">
      <div class="modal-head"><h3>Login Construsud</h3></div>
      <div class="modal-body">
        <div class="field" style="margin-bottom:10px"><label>Email</label><input id="liEmail" type="email" placeholder="geral@construsud.com"></div>
        <div class="field"><label>Password</label><input id="liPwd" type="password"></div>
        <div class="hint" style="margin-top:8px;font-size:11px">Primeira vez? A conta é criada automaticamente.</div>
      </div>
      <div class="modal-foot">
        <button class="btn" id="liSkip">Continuar offline</button>
        <button class="btn btn-primary" id="liGo">Entrar</button>
      </div>
    </div>`;
  document.body.appendChild(div);
  $('#liGo').onclick = async ()=>{
    const email = $('#liEmail').value.trim();
    const pwd = $('#liPwd').value;
    if (!email || !pwd) return;
    const ok = await Firebase.login(email, pwd);
    if (ok) div.remove();
  };
  $('#liSkip').onclick = ()=> div.remove();
  $('#liEmail').focus();
}

/* ======================== BOOT ======================== */
async function loadSeeds(){
  // Seeds embedded above as window.__SEED__
  return;
}

async function boot(){
  await loadSeeds();
  Store.load();
  buildNav();
  navigate();
  // Initialize Firebase if SDK is ready and config present
  const initFb = async ()=>{
    if (!window.fb) return;
    const has = Store.data?.config?.firebase?.apiKey;
    if (has){
      const ok = await Firebase.init();
      if (ok && !Firebase.user){
        showLoginOverlay();
      }
    }
  };
  if (window.fb) initFb();
  else window.addEventListener('fb:ready', initFb);
  document.addEventListener('fb:auth', ()=>{
    const status = $('#storage-status');
    if (Firebase.user) {
      status.innerHTML = `<span style="color:#9FC; padding:2px 6px;background:#0a3015;border-radius:4px">☁ ${Firebase.user.email.split('@')[0]}</span>`;
    } else {
      status.textContent = `${Store.data.propostas.length} propostas · ${Store.data.clientes.length} clientes`;
    }
  });
  $('#storage-status').textContent = `${Store.data.propostas.length} propostas · ${Store.data.clientes.length} clientes`;
  window.addEventListener('hashchange', navigate);
  document.addEventListener('store:change', ()=>{
    $('#storage-status').textContent = `${Store.data.propostas.length} propostas · ${Store.data.clientes.length} clientes`;
  });
  // Global search
  $('#globalSearch').addEventListener('input', e=>{
    const q = e.target.value.toLowerCase().trim();
    if (!q) return;
    const m = Store.data.propostas.find(p=>(String(p.numero)+' '+p.clienteNome+' '+p.obraNome).toLowerCase().includes(q));
    if (q.length>2 && m) location.hash = `#propostas/${m.id}`;
  });
}
boot();
</script>
