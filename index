        };
        d.clientes.push(cli);
        clienteByName.set(cliNome, cli.id);
      }
    });
    // Reverse so older proposals come first
    crmSeed.slice().reverse().forEach(p=>{
      const numero = p['Nº Obra'];
      if (!numero) return;
      const cliNome = (p.Cliente||'').trim();
      const versao = (p['Versão']||'V0').toUpperCase();
      const status = mapStatusFromCRM(p.Status);
      const dataEnvio = parseDate(p['Data Envio']);
