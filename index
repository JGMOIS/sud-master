        <option value="adjudicado" ${prop.status==='adjudicado'?'selected':''}>Adjudicado</option>
        <option value="cancelado" ${prop.status==='cancelado'?'selected':''}>Cancelado</option>
      </select>
    </div>
    <div class="field" id="adjF" style="display:none;margin-top:10px"><label>Valor adjudicado (€)</label><input type="number" step="0.01" id="msVA" value="${prop.valorAdjudicado||prop.valorTotal||0}"></div>`;
