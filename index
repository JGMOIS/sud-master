function modal({title, body, footer, width}){
  return new Promise(resolve=>{
    const back = document.createElement('div');
    back.className = 'modal-back';
    const m = document.createElement('div');
    m.className = 'modal' + (width==='large' ? ' large':'');
    m.innerHTML = `
      <div class="modal-head"><h3>${escapeHTML(title)}</h3><div class="grow" style="flex:1"></div><button class="btn btn-ghost btn-sm" data-act="cancel">✕</button></div>
      <div class="modal-body"></div>
      <div class="modal-foot"></div>
    `;
    if (typeof body === 'string') m.querySelector('.modal-body').innerHTML = body;
    else m.querySelector('.modal-body').appendChild(body);
    if (footer){
      m.querySelector('.modal-foot').appendChild(footer);
    } else {
      m.querySelector('.modal-foot').innerHTML = `<button class="btn" data-act="cancel">Cancelar</button><button class="btn btn-primary" data-act="ok">OK</button>`;
    }
    back.appendChild(m);
    $('#modalRoot').appendChild(back);
    function close(v){ back.remove(); resolve(v); }
    back.addEventListener('click', e=>{
      if (e.target===back) close(null);
      const act = e.target.closest('[data-act]')?.dataset.act;
      if (act==='cancel') close(null);
      if (act==='ok') close(true);
    });
    m._close = close;
  });
}

