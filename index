      <div class="field"><label>Versão</label><input value="V0" disabled></div>
    </div>`;
  const m = await modal({title:'Nova Proposta', body});
  if (!m) return;
  const nome = body.querySelector('#ncCliente').value.trim();
  const obra = body.querySelector('#ncObra').value.trim();
  const morada = body.querySelector('#ncMorada').value.trim();
  const numero = Number(body.querySelector('#ncNumero').value);
  if (!nome || !obra || !numero){ toast('Preencha cliente, obra e nº'); return; }
  let cli = d.clientes.find(c=>c.nome.toLowerCase()===nome.toLowerCase());
  if (!cli){
    cli = {id:uid(),nome,contacto:'',email:'',telefone:'',morada,nif:'',notas:''};
    d.clientes.push(cli);
  }
  const prop = {
    id: uid(), numero, versao:'V0',
    clienteId: cli.id, clienteNome: cli.nome,
    obraNome: obra, morada,
    status:'por_enviar',
    dataEnvio: null, dataAdjudicacao: null,
    validade:'7 dias',
    condicoesPgto:['30% na adjudicação','restante em Autos Mensais'],
    valorTotal:0, custoTotal:0, custoSeco:0, margem:0,
    capitulos:[], parcelaDiluida:{total:0, partilhas:{gestao:0,margem:0,materiais:0,maoObra:0,subs:0,logistica:0}},
    notas:'', _seedOnly:false
  };
  d.propostas.unshift(prop);
  if (numero >= d.config.proximoNumero) d.config.proximoNumero = numero+1;
  Store.save();
  location.hash = `#propostas/${prop.id}`;
}

