    if (raw){ try{ this.data = JSON.parse(raw); }catch{ this.data = null; } }
    if (!this.data) this.data = this.bootstrap();
    return this.data;
  },
  save(){
    localStorage.setItem(LS_KEY, JSON.stringify(this.data));
    document.dispatchEvent(new Event('store:change'));
  },
  bootstrap(){
    // v0.3: prefer full SEED_V03 if available (already includes propostas/clientes/BD)
    if (SEED.propostas && SEED.clientes && SEED.bdAtividades){
      const d = JSON.parse(JSON.stringify(SEED));
