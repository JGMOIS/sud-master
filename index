function parseDate(v){
  if (!v) return null;
  if (typeof v === 'number'){
    // Excel serial
    const d = new Date(Math.round((v - 25569) * 86400 * 1000));
    return d.toISOString().slice(0,10);
  }
  if (typeof v === 'string'){
    const m = v.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if (m) return `${m[3]}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`;
    if (v.length>=10) return v.slice(0,10);
  }
  return null;
}

function mapStatusFromCRM(s){
  if (!s) return 'por_enviar';
  const x = String(s).toLowerCase();
  if (x.includes('adjud')) return 'adjudicado';
  if (x.includes('por enviar')) return 'por_enviar';
  if (x.includes('por aprov')) return 'por_aprovar';
  if (x.includes('reprov') || x.includes('cancel') || x.includes('anul')) return 'cancelado';
  return 'por_enviar';
}

function importCapitulos(caps){
  return caps.map(c=>({
    id: uid(),
    numero: c.numero, titulo: c.titulo,
    subcapitulos: (c.subcapitulos||[]).map(sc=>({
      id: uid(),
      codigo: sc.codigo, titulo: sc.titulo,
      atividades: (sc.atividades||[]).map(a=>importAtividade(a))
    })),
    atividadesDiretas: (c.atividades_diretas||[]).map(a=>importAtividade(a))
  }));
}

function importAtividade(a){
  // Translate spreadsheet activity to internal model
  return {
    id: uid(),
    codigo: a.codigo,
    descricao: a.descricao,
    unidade: a.unidade,
    quantidade: Number(a.quantidade)||0,
    materiais: (a.materiais||[]).map(m=>({
      id: uid(),
      descricao: m.descricao,
      desperdicio: Number(m.desperdicio)||0,
      unidade: m.unidade,
      quantidade: Number(m.quantidade)||0,  // stored as base qty (input by user)
      precoUn: Number(m.preco_un)||0
    })),
    equipa: ({E:'1E', O:'1O', A:'1A'})[a.mo_tipo] || '1E',
    moHoras: Number(a.mo_horas)||0,
    moModoCalculo: 'horas',  // 'horas' | 'rendimento' | 'duracao'
    moDuracaoDias: 0,
    moRendimento: 0,
    subs: (a.subempreiteiros||[]).map(s=>({id:uid(), nome:s.nome||'', modo:s.modo||'total', valor:Number(s.valor)||0, total:Number(s.valor)||0})),
    logisticaTotal: Number(a.logistica_total)||0,
    logisticaKM: Number(a.logistica_km)||0,
    diversosAlimentacao: 0,
    diversosPassagens: 0,
    diversosOutros: 0,
    modoVenda: 'margem',  // 'margem' | 'unitario'
    margemPct: typeof a.margem_pct === 'number' ? a.margem_pct : 0.21,
    vendaUnitaria: typeof a.preco_unitario === 'number' ? a.preco_unitario : 0,
    notaCliente: '',
    notaInterna: '',
    mostrarNotaCliente: false,
    // computed (populated by recomputarTudo)
    custoMateriais:0, custoMO:0, custoSubs:0, custoLogistica:0, custoDiversos:0,
    custoSeco:0, parcelaDiluidaTotal:0, custoTotal:0, vendaTotal:0, margemEur:0
  };
}

/* ======================== CÁLCULOS ======================== */
function getEquipa(codigo){
  return Store.data.equipas.find(e=>e.codigo===codigo) || Store.data.equipas[2]; // 1E default
}

function recomputarAtividade(at){
  // Materiais
  at.custoMateriais = at.materiais.reduce((s,m)=>{
    const qReal = m.quantidade * (1 + (Number(m.desperdicio)||0));
    m._qtdReal = qReal;
    m._total = qReal * (Number(m.precoUn)||0);
    return s + m._total;
  }, 0);
  // Mão de Obra
  const eq = getEquipa(at.equipa);
  at.custoMO = (Number(at.moHoras)||0) * (eq?.custoH||0);
  // Subs
  at.custoSubs = (at.subs||[]).reduce((s,x)=>s + (Number(x.total)||0), 0);
  // Logística
  at.custoLogistica = (Number(at.logisticaTotal)||0);
  // Diversos
  at.custoDiversos = (Number(at.diversosAlimentacao)||0)+(Number(at.diversosPassagens)||0)+(Number(at.diversosOutros)||0);
  // Custo seco (sem parcela diluída)
  at.custoSeco = at.custoMateriais + at.custoMO + at.custoSubs + at.custoLogistica + at.custoDiversos;
  return at;
}

function recomputarTudo(prop){
  // 1) Recalcular cada atividade (sem parcela diluída ainda)
  for (const cap of prop.capitulos){
    for (const sub of cap.subcapitulos){
      for (const at of sub.atividades) recomputarAtividade(at);
    }
    for (const at of (cap.atividadesDiretas||[])) recomputarAtividade(at);
  }
  // 2) Total de custo seco da obra
  let custoSecoTotal = 0;
  for (const cap of prop.capitulos){
    for (const sub of cap.subcapitulos) for (const at of sub.atividades) custoSecoTotal += at.custoSeco;
    for (const at of (cap.atividadesDiretas||[])) custoSecoTotal += at.custoSeco;
  }
  // 3) Distribuir parcela diluída ponderada por custoSeco
  const pd = prop.parcelaDiluida || {total:0,partilhas:{}};
  const pdTotal = Number(pd.total)||0;
  for (const cap of prop.capitulos){
    const aplicar = (at)=>{
      const peso = custoSecoTotal>0 ? at.custoSeco / custoSecoTotal : 0;
      at.parcelaDiluidaTotal = pdTotal * peso;
      at.custoTotal = at.custoSeco + at.parcelaDiluidaTotal;
      // Venda
      if (at.modoVenda === 'unitario'){
        at.vendaTotal = (Number(at.vendaUnitaria)||0) * (Number(at.quantidade)||0);
        at.margemEur = at.vendaTotal - at.custoTotal;
        at.margemPct = at.vendaTotal>0 ? at.margemEur / at.vendaTotal : 0;
      } else {
        const m = Number(at.margemPct)||0;
        at.vendaTotal = m<1 ? at.custoTotal / (1 - m) : at.custoTotal;
        at.vendaUnitaria = at.quantidade>0 ? at.vendaTotal / at.quantidade : 0;
        at.margemEur = at.vendaTotal - at.custoTotal;
      }
    };
    for (const sub of cap.subcapitulos) for (const at of sub.atividades) aplicar(at);
    for (const at of (cap.atividadesDiretas||[])) aplicar(at);
  }
  // 4) Totais por capítulo
  let total=0, custoTotalProp=0, custoSeco=0;
  for (const cap of prop.capitulos){
    let tcap=0;
    for (const sub of cap.subcapitulos) for (const at of sub.atividades){ tcap+=at.vendaTotal; custoTotalProp+=at.custoTotal; custoSeco+=at.custoSeco; }
    for (const at of (cap.atividadesDiretas||[])){ tcap+=at.vendaTotal; custoTotalProp+=at.custoTotal; custoSeco+=at.custoSeco; }
    cap._total = tcap;
    total += tcap;
  }
  prop.valorTotal = total;
  prop.custoTotal = custoTotalProp;
  prop.custoSeco = custoSeco;
  prop.margem = total>0 ? (total-custoTotalProp)/total : 0;
  return prop;
}

