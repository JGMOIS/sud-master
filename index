        capitulos: [],
        parcelaDiluida: {total:0, partilhas:{gestao:0,margem:0,materiais:0,maoObra:0,subs:0,logistica:0}},
        notas:'',
        _seedOnly: true
      });
    });
    // Detailed budget for 2618 V1 — set Store.data first so recomputar reads equipas
    Store.data = d;
    const seed = SEED.orc2618;
    if (seed){
      // Find the V1 row we just created
