function findAt(prop, id){
  for (const c of prop.capitulos){
    for (const sc of c.subcapitulos){ const a = sc.atividades.find(x=>x.id===id); if (a) return {at:a, sub:sc, cap:c}; }
    const a = (c.atividadesDiretas||[]).find(x=>x.id===id); if (a) return {at:a, sub:null, cap:c};
  }
  return null;
}

function treeClick(e, prop){
  const root = $('#treeRoot');
  const t = e.target;
  const act = t.closest('[data-act]')?.dataset.act;
  const actEl = t.closest('.tree-act');
  const subEl = t.closest('.tree-sub');
  const capEl = t.closest('.tree-chap');
  if (act === 'toggle' && actEl){ actEl.classList.toggle('open'); }
  else if (act === 'add-sub' && capEl){
    const cap = prop.capitulos.find(c=>c.id===capEl.dataset.cap);
    cap.subcapitulos.push({id:uid(), codigo:`${cap.numero}.${cap.subcapitulos.length+1}`, titulo:'Novo subcapítulo', atividades:[]});
    Store.save(); renderAtividades(prop);
  }
  else if (act === 'del-cap' && capEl){
    if (confirm('Eliminar capítulo?')){
      prop.capitulos = prop.capitulos.filter(c=>c.id!==capEl.dataset.cap);
      Store.save(); renderAtividades(prop);
    }
  }
  else if (act === 'add-act' && subEl){
    const cap = prop.capitulos.find(c=>c.id===capEl.dataset.cap);
    const sub = cap.subcapitulos.find(s=>s.id===subEl.dataset.sub);
    sub.atividades.push(emptyAtividade(`${sub.codigo}.${sub.atividades.length+1}`));
    Store.save(); renderAtividades(prop);
  }
  else if (act === 'del-sub' && subEl){
    if (confirm('Eliminar subcapítulo?')){
      const cap = prop.capitulos.find(c=>c.id===capEl.dataset.cap);
      cap.subcapitulos = cap.subcapitulos.filter(s=>s.id!==subEl.dataset.sub);
      Store.save(); renderAtividades(prop);
    }
  }
  else if (act === 'del-act' && actEl){
    if (confirm('Eliminar atividade?')){
      removeAt(prop, actEl.dataset.actId);
      Store.save(); renderAtividades(prop);
    }
  }
  else if (act === 'add-mat' && actEl){
    const f = findAt(prop, actEl.dataset.actId);
    f.at.materiais.push({id:uid(), descricao:'', desperdicio:0, unidade:'un', quantidade:0, precoUn:0});
    Store.save(); refreshAtividade(prop, actEl.dataset.actId);
  }
  else if (act === 'del-mat' && actEl){
    const f = findAt(prop, actEl.dataset.actId);
    f.at.materiais.splice(Number(t.closest('[data-act]').dataset.i),1);
    Store.save(); refreshAtividade(prop, actEl.dataset.actId);
  }
  else if (act === 'add-sub-i' && actEl){
    const f = findAt(prop, actEl.dataset.actId);
    f.at.subs.push({id:uid(), nome:'', modo:'total', valor:0, total:0});
    Store.save(); refreshAtividade(prop, actEl.dataset.actId);
  }
  else if (act === 'del-sub-i' && actEl){
    const f = findAt(prop, actEl.dataset.actId);
    f.at.subs.splice(Number(t.closest('[data-act]').dataset.i),1);
    Store.save(); refreshAtividade(prop, actEl.dataset.actId);
  }
  // re-attach (because we used {once:true})
  root.addEventListener('click', e=>treeClick(e, prop), {once:true});
  root.addEventListener('input', e=>treeInput(e, prop), {once:true});
}

function treeInput(e, prop){
  const root = $('#treeRoot');
  const t = e.target;
  const actEl = t.closest('.tree-act');
  const subEl = t.closest('.tree-sub');
  const capEl = t.closest('.tree-chap');
  if (t.matches('[data-edit="cap-titulo"]') && capEl){
    const cap = prop.capitulos.find(c=>c.id===capEl.dataset.cap);
    cap.titulo = t.value;
  }
  else if (t.matches('[data-edit="sub-titulo"]') && subEl){
    const cap = prop.capitulos.find(c=>c.id===capEl.dataset.cap);
    const sub = cap.subcapitulos.find(s=>s.id===subEl.dataset.sub);
    sub.titulo = t.value;
  }
  else if (actEl){
    const f = findAt(prop, actEl.dataset.actId);
    if (!f) return;
    const at = f.at;
    if (t.matches('[data-field]')){
      const k = t.dataset.field;
      let v = t.type==='checkbox'? t.checked : t.type==='number' ? Number(t.value) : t.value;
      if (k==='margemPct') v = v/100;
      at[k] = v;
    } else if (t.matches('[data-mf]')){
      const i = Number(t.closest('tr[data-mat]').dataset.mat);
      const k = t.dataset.mf;
      at.materiais[i][k] = t.type==='number'? Number(t.value) : t.value;
    } else if (t.matches('[data-sf]')){
      const i = Number(t.closest('tr[data-sub-i]').dataset.subI);
      const k = t.dataset.sf;
      at.subs[i][k] = t.type==='number'? Number(t.value) : t.value;
      // compute sub total
      const s = at.subs[i];
      s.total = s.modo==='unit' ? (s.valor||0)*(at.quantidade||0) : (s.valor||0);
    }
    recomputarTudo(prop);
    refreshOutputs(prop, actEl.dataset.actId);
  }
  Store.save();
  root.addEventListener('click', e=>treeClick(e, prop), {once:true});
  root.addEventListener('input', e=>treeInput(e, prop), {once:true});
}

function refreshOutputs(prop, atId){
  const f = findAt(prop, atId); if (!f) return;
  const at = f.at;
  const root = document.querySelector(`[data-act-id="${atId}"]`);
  if (!root) return;
  root.querySelector('[data-out="vendaTotal"]').textContent = fmtEUR(at.vendaTotal||0);
  root.querySelector('[data-out="custoMO"]')?.replaceChildren(document.createTextNode(fmtEUR(at.custoMO||0)));
  root.querySelector('[data-out="custoMO2"]')?.replaceChildren(document.createTextNode(fmtEUR(at.custoMO||0)));
  root.querySelector('[data-out="custoSubs"]')?.replaceChildren(document.createTextNode(fmtEUR(at.custoSubs||0)));
  root.querySelector('[data-out="custoSubs2"]')?.replaceChildren(document.createTextNode(fmtEUR(at.custoSubs||0)));
  root.querySelector('[data-out="custoMateriais"]')?.replaceChildren(document.createTextNode(fmtEUR(at.custoMateriais||0)));
  root.querySelector('[data-out="custoSeco"]')?.replaceChildren(document.createTextNode(fmtEUR(at.custoSeco||0)));
  root.querySelector('[data-out="margemEur"]')?.replaceChildren(document.createTextNode(fmtEUR(at.margemEur||0)));
  root.querySelector('[data-out="vendaUn"]')?.replaceChildren(document.createTextNode(fmtEUR(at.vendaUnitaria||0)));
  root.querySelectorAll('tr[data-mat]').forEach((tr,i)=>{
    const m = at.materiais[i]; if (!m) return;
    tr.querySelector('[data-out="qtdReal"]').textContent = fmtNum(m._qtdReal||0,3);
    tr.querySelector('[data-out="totalMat"]').textContent = fmtEUR(m._total||0);
  });
  // capítulo total
  const capId = f.cap.id;
  const capEl = document.querySelector(`[data-cap="${capId}"] .tree-chap-head .total`);
  if (capEl) capEl.textContent = fmtEUR(f.cap._total||0);
}

function refreshAtividade(prop, atId){
  // Re-render full activity body (after add/remove material)
  const f = findAt(prop, atId);
  const root = document.querySelector(`[data-act-id="${atId}"] .tree-act-body`);
  if (root){
    root.innerHTML = renderAtividadeBody(f.at);
    document.querySelector(`[data-act-id="${atId}"]`).classList.add('open');
  }
  recomputarTudo(prop);
  refreshOutputs(prop, atId);
}

function emptyAtividade(codigo){
  return {
    id: uid(), codigo, descricao:'', unidade:'un', quantidade:0,
    materiais:[], equipa:'1E', moHoras:0, moModoCalculo:'horas', moDuracaoDias:0, moRendimento:0,
    subs:[], logisticaTotal:0, logisticaKM:0, diversosAlimentacao:0, diversosPassagens:0, diversosOutros:0,
    modoVenda:'margem', margemPct:0.21, vendaUnitaria:0, notaCliente:'', notaInterna:'', mostrarNotaCliente:false,
    custoMateriais:0,custoMO:0,custoSubs:0,custoLogistica:0,custoDiversos:0,custoSeco:0,parcelaDiluidaTotal:0,custoTotal:0,vendaTotal:0,margemEur:0
  };
}

function removeAt(prop, atId){
  for (const c of prop.capitulos){
    for (const s of c.subcapitulos){ const i = s.atividades.findIndex(a=>a.id===atId); if (i>=0){ s.atividades.splice(i,1); return; } }
    if (c.atividadesDiretas){ const i = c.atividadesDiretas.findIndex(a=>a.id===atId); if (i>=0){ c.atividadesDiretas.splice(i,1); return; } }
  }
}

function addCap(prop){
  const n = prop.capitulos.length + 1;
  prop.capitulos.push({id:uid(), numero:n, titulo:'NOVO CAPÍTULO', subcapitulos:[], atividadesDiretas:[]});
  Store.save();
  ViewPropostaEditor($('#view'), prop.id);
}

async function importarDoBD(prop){
  const bd = Store.data.bdAtividades;
  if (!bd.length){ toast('BD de atividades vazia'); return; }
  const body = document.createElement('div');
  body.innerHTML = `
    <input id="bdSearch" placeholder="Pesquisar…" style="width:100%;padding:8px;border:1px solid #ccc;border-radius:6px;margin-bottom:10px">
    <div style="max-height:50vh;overflow-y:auto" id="bdList"></div>
    <p class="muted" style="font-size:12px;margin-top:10px">Selecione uma atividade. Será adicionada ao último capítulo (ou crie um capítulo primeiro).</p>`;
  function render(){
    const q = body.querySelector('#bdSearch').value.toLowerCase();
    const list = bd.filter(a=>a.descricao.toLowerCase().includes(q));
    body.querySelector('#bdList').innerHTML = list.map(a=>`
      <div data-bd="${a.id}" style="padding:8px;border-bottom:1px solid #eee;cursor:pointer">
        <div style="font-weight:600">${escapeHTML(a.descricao)}</div>
        <div class="muted" style="font-size:11px">${a.unidade} · ${a.materiais.length} materiais · ${fmtNum(a.rendimentoH||0,2)} h/un</div>
      </div>
    `).join('');
    body.querySelectorAll('[data-bd]').forEach(d=>d.onclick=()=>{
      m._close({id:d.dataset.bd});
    });
  }
  body.querySelector('#bdSearch').oninput = render;
  render();
  const m = await modal({title:'Importar do BD', body, footer: (()=>{ const f=document.createElement('div'); f.innerHTML='<button class="btn" data-act="cancel">Fechar</button>'; return f; })()});
  if (!m || !m.id) return;
  const a = bd.find(x=>x.id===m.id);
  let cap = prop.capitulos[prop.capitulos.length-1];
  if (!cap){ addCap(prop); cap = prop.capitulos[0]; }
  let sub = cap.subcapitulos[cap.subcapitulos.length-1];
  if (!sub){ sub = {id:uid(), codigo:`${cap.numero}.1`, titulo:'IMPORTADAS', atividades:[]}; cap.subcapitulos.push(sub); }
  const novaCodigo = `${sub.codigo}.${sub.atividades.length+1}`;
  const at = emptyAtividade(novaCodigo);
  at.descricao = a.descricao; at.unidade = a.unidade;
  at.materiais = a.materiais.map(m=>({id:uid(), descricao:m.descricao, desperdicio:m.desperdicio||0, unidade:m.unidade, quantidade:0, precoUn:m.precoUn||0}));
  sub.atividades.push(at);
  Store.save();
  toast('Atividade importada');
  ViewPropostaEditor($('#view'), prop.id);
}

/* ----------- Parcela diluída ----------- */
function renderDiluida(prop){
  const pd = prop.parcelaDiluida;
  $('#tabBody').innerHTML = `
    <p class="muted">Indique um valor a diluir em todo o orçamento. Será distribuído entre todas as atividades, ponderado pelo custo seco de cada uma face ao custo seco total da obra. As partilhas indicam o destino contabilístico do valor — útil para gerir tetos de custo durante a execução.</p>
    <div class="form-grid cols-3" style="margin-top:14px">
      <div class="field"><label>Valor total a diluir (€)</label><input type="number" step="0.01" id="pdTotal" value="${pd.total||0}"></div>
      <div class="field"><label>Custo Seco da Obra</label><input value="${fmtEUR(prop.custoSeco)}" disabled></div>
      <div class="field"><label>Atividades a receber peso</label><input value="${countAtividades(prop)}" disabled></div>
    </div>
    <h4 style="margin-top:18px">Partilha por centro de custo</h4>
    <div class="form-grid cols-3">
      ${['gestao','margem','materiais','maoObra','subs','logistica'].map(k=>`
        <div class="field"><label>${({gestao:'Gestão',margem:'Margem',materiais:'Materiais',maoObra:'Mão de Obra',subs:'Subempreiteiros',logistica:'Logística'})[k]} (€)</label>
          <input type="number" step="0.01" data-pdp="${k}" value="${pd.partilhas[k]||0}"></div>`).join('')}
    </div>
    <div class="row" style="margin-top:14px">
      <span class="muted">Soma das partilhas: <b id="pdSomas">0</b> · deve ser igual ao total.</span>
      <div class="spacer"></div>
      <button class="btn btn-primary" id="pdSalvar">Aplicar</button>
    </div>
    <div class="panel" style="margin-top:18px">
      <div class="panel-head"><h2>Distribuição prevista por atividade (top 10)</h2></div>
      <div class="panel-body tight">
        <table class="tbl"><thead><tr><th>Cod.</th><th>Atividade</th><th class="num">Custo Seco</th><th class="num">Peso</th><th class="num">Diluído</th></tr></thead>
        <tbody>${distribuicaoTop10(prop)}</tbody></table>
      </div>
    </div>
  `;
  function recompPD(){
    const sum = ['gestao','margem','materiais','maoObra','subs','logistica'].reduce((s,k)=> s + (Number($(`[data-pdp="${k}"]`).value)||0), 0);
    $('#pdSomas').textContent = fmtEUR(sum);
    $('#pdSomas').style.color = Math.abs(sum - Number($('#pdTotal').value||0)) < 0.01 ? 'var(--green)' : 'var(--red)';
  }
  $$('input[data-pdp], #pdTotal').forEach(i=> i.addEventListener('input', recompPD));
  recompPD();
  $('#pdSalvar').onclick = ()=>{
    pd.total = Number($('#pdTotal').value)||0;
    for (const k of ['gestao','margem','materiais','maoObra','subs','logistica']) pd.partilhas[k] = Number($(`[data-pdp="${k}"]`).value)||0;
    Store.save();
    toast('Parcela diluída aplicada');
    renderDiluida(prop);
  };
}

function distribuicaoTop10(prop){
  const lista = [];
  for (const c of prop.capitulos){
    for (const s of c.subcapitulos) for (const a of s.atividades) lista.push(a);
    for (const a of (c.atividadesDiretas||[])) lista.push(a);
  }
  lista.sort((a,b)=>b.custoSeco-a.custoSeco);
  return lista.slice(0,10).map(a=>{
    const peso = prop.custoSeco>0 ? a.custoSeco/prop.custoSeco : 0;
    return `<tr class="no-hover"><td>${a.codigo}</td><td>${escapeHTML(a.descricao)}</td><td class="num">${fmtEUR(a.custoSeco)}</td><td class="num">${fmtPct(peso)}</td><td class="num">${fmtEUR(a.parcelaDiluidaTotal||0)}</td></tr>`;
  }).join('') || `<tr class="no-hover"><td colspan="5" class="muted">Sem atividades</td></tr>`;
}

