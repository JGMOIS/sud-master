function buildNav(){
  const nav = $('#nav');
  const sections = {};
  ROUTES.forEach(r=>{ if(!sections[r.section]) sections[r.section]=[]; sections[r.section].push(r); });
  let html = '';
  for (const sec of Object.keys(sections)){
    html += `<div class="nav-section">${sec}</div>`;
    for (const r of sections[sec]){
      html += `<a href="#${r.id}" data-route="${r.id}" class="${r.coming?'coming':''}">
        <span class="ic">${r.icon}</span>
        <span>${r.label}</span>
        ${r.coming?'<span class="badge">soon</span>':''}
      </a>`;
    }
  }
  nav.innerHTML = html;
}

function setActive(id){
  $$('#nav a').forEach(a=>a.classList.toggle('active', a.dataset.route===id));
}

function navigate(){
  const hash = (location.hash||'#dashboard').slice(1);
  const [route, ...rest] = hash.split('/');
  const r = ROUTES.find(x=>x.id===route) || ROUTES[0];
  setActive(r.id);
  $('#crumb').innerHTML = `<b>${r.label}</b>` + (rest.length?` · <span class="muted">${rest.join(' / ')}</span>`:'');
  const view = $('#view');
  view.innerHTML = '';
  if (r.coming) return ViewComingSoon(view, r);
  switch(r.id){
    case 'dashboard': return ViewDashboard(view);
    case 'propostas':
      if (rest.length) return ViewPropostaEditor(view, rest[0]);
      return ViewPropostas(view);
    case 'obras': return ViewObras(view);
    case 'clientes': return ViewClientes(view);
    case 'bd-atividades': return ViewBDAtividades(view);
    case 'bd-materiais': return ViewBDMateriais(view);
    case 'equipas': return ViewEquipas(view);
    case 'config': return ViewConfig(view);
  }
}

