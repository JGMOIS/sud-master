  doc.text(`ATT: ${prop.clienteNome||''}`, M, M+38);
  doc.text(`Lisboa, ${prop.dataEnvio||todayISO()}`, M, M+45);
  doc.setTextColor(0,0,0);

  // Mensagem
  doc.text('No seguimento da vossa solicitação, apresentamos a nossa proposta de serviços:', M, M+58);

  // Box de valor
  let y = M+72;
  doc.setFontSize(11);
  doc.setTextColor(120,120,120);
  doc.text('Proposta:', W-M-70, y);
  doc.setTextColor(0,0,0); doc.setFont('helvetica','bold');
  doc.text(`${prop.versao}${prop.numero}`, W-M-30, y);
  y += 8;
  doc.setFont('helvetica','normal'); doc.setTextColor(120,120,120);
  doc.text('Valor:', W-M-70, y);
  doc.setTextColor(0,0,0); doc.setFont('helvetica','bold'); doc.setFontSize(14);
  doc.text(fmtEUR(prop.valorTotal||0), W-M-30, y);
  y += 6; doc.setFont('helvetica','italic'); doc.setFontSize(9); doc.setTextColor(140,140,140);
  doc.text('IVA em vigor não incluído', W-M-30, y);

  // Condições
  y = M+115;
  doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(120,120,120);
  doc.text('Condições de Pagamento:', M, y);
  doc.setTextColor(0,0,0);
  for (const c of (prop.condicoesPgto||[])){ y += 5; doc.text(c, M+50, y); }

  // Validade
  y += 12;
  doc.setTextColor(120,120,120);
  doc.text('Validade da Proposta:', M, y);
  doc.setTextColor(0,0,0);
  doc.text(prop.validade||'7 dias', M+50, y);

  // Encerramento
  y = H-M-35;
  doc.setFontSize(10);
  doc.text('Aguardamos o vosso contato e agradecemos o interesse.', M, y);
  y += 12;
  doc.setFontSize(9); doc.setTextColor(120,120,120);
  doc.text('Gestor de Projeto', M, y);
  doc.text('Administrador', M+85, y);
  y += 5; doc.setTextColor(0,0,0); doc.setFont('helvetica','bold');
  doc.text(cfg.empresa.gestorProjeto.nome, M, y);
  doc.text(cfg.empresa.administrador.nome, M+85, y);
  y += 5; doc.setFont('helvetica','normal'); doc.setFontSize(9);
  doc.text(cfg.empresa.gestorProjeto.tel, M, y);
  doc.text(cfg.empresa.administrador.tel, M+85, y);
  y += 5;
  doc.text(cfg.empresa.gestorProjeto.email, M, y);
  doc.text(cfg.empresa.administrador.email, M+85, y);

  // ============ PAGE 2: Resumo ============
  doc.addPage();
  pageHeader(doc, prop, M, RED);
  let yy = M+30;
  doc.setFontSize(13); doc.setFont('helvetica','bold');
  doc.text('Resumo do Orçamento', M, yy);
  yy += 8;
  const resumoRows = prop.capitulos.map(c=>[
    `CAP. ${c.numero}`, c.titulo, fmtEUR(c._total||0)
  ]);
  doc.autoTable({
    startY: yy,
    head: [['CAP.','Título','Valor']],
    body: resumoRows,
    foot: [['','Total', fmtEUR(prop.valorTotal||0)]],
    theme:'plain',
    styles:{fontSize:10, cellPadding:3},
    headStyles:{fillColor:RED, textColor:255, fontStyle:'bold'},
    footStyles:{fillColor:[230,230,230], fontStyle:'bold'},
    columnStyles:{0:{cellWidth:25}, 2:{halign:'right', cellWidth:35}},
    margin:{left:M, right:M}
  });

  // ============ PAGES: Atividades por capítulo ============
  for (const cap of prop.capitulos){
    doc.addPage();
    pageHeader(doc, prop, M, RED);
    let cy = M+30;
    doc.setFillColor(...RED); doc.rect(M, cy, 30, 7, 'F');
    doc.setTextColor(255,255,255); doc.setFontSize(10); doc.setFont('helvetica','bold');
    doc.text(`CAP. ${cap.numero}`, M+15, cy+5, {align:'center'});
    doc.setTextColor(0,0,0);
    doc.text(cap.titulo, M+34, cy+5);
    cy += 12;

    const rows = [];
    for (const sub of cap.subcapitulos){
      rows.push([{content: sub.codigo, styles:{fontStyle:'bold'}}, {content: sub.titulo, colSpan:4, styles:{fontStyle:'bold', fillColor:[245,245,245]}}]);
      for (const at of sub.atividades){
        rows.push([
          at.codigo,
          at.descricao + (at.mostrarNotaCliente && at.notaCliente ? `\n\nNota: ${at.notaCliente}`:''),
          at.unidade,
          fmtNum(at.quantidade||0,2),
          at.vendaUnitaria ? fmtEUR(at.vendaUnitaria) : (typeof at.descricao==='string'&&at.descricao.length?'A definir':''),
          at.vendaTotal ? fmtEUR(at.vendaTotal) : ''
        ]);
      }
    }
    for (const at of (cap.atividadesDiretas||[])){
      rows.push([
        at.codigo, at.descricao, at.unidade,
        fmtNum(at.quantidade||0,2),
        at.vendaUnitaria? fmtEUR(at.vendaUnitaria) : 'A definir',
        at.vendaTotal? fmtEUR(at.vendaTotal): ''
      ]);
    }
    rows.push([{content:'', colSpan:4, styles:{fillColor:[245,245,245]}}, {content:`Total CAP. ${cap.numero}`, styles:{fontStyle:'bold', fillColor:[245,245,245]}}, {content: fmtEUR(cap._total||0), styles:{fontStyle:'bold', fillColor:[245,245,245], halign:'right'}}]);

    doc.autoTable({
      startY: cy,
      head:[['Cód.','Descrição','UN.','QTD.','€/UN','€']],
      body: rows,
      theme:'striped',
      styles:{fontSize:9, cellPadding:2.5, valign:'middle'},
      headStyles:{fillColor:[40,45,55], textColor:255},
      columnStyles:{0:{cellWidth:18}, 2:{cellWidth:14}, 3:{halign:'right',cellWidth:18}, 4:{halign:'right',cellWidth:25}, 5:{halign:'right',cellWidth:28}},
      margin:{left:M, right:M}
    });
  }

  // ============ Última página: lista consolidada de materiais ============
  doc.addPage();
  pageHeader(doc, prop, M, RED);
  let my = M+30;
  doc.setFontSize(13); doc.setFont('helvetica','bold');
  doc.text('Lista Consolidada de Materiais', M, my);
  my += 8;
  const cons = consolidarMateriais(prop);
  doc.autoTable({
    startY: my,
    head: [['Material','Un.','Qtd. real','€/un','Total']],
    body: cons.map(m=>[m.descricao, m.unidade, fmtNum(m.qtdReal,3), fmtEUR(m.precoUn), fmtEUR(m.total)]),
    theme:'striped',
    styles:{fontSize:9, cellPadding:2.5},
    headStyles:{fillColor:[40,45,55], textColor:255},
    columnStyles:{1:{cellWidth:14}, 2:{halign:'right',cellWidth:25}, 3:{halign:'right',cellWidth:25}, 4:{halign:'right',cellWidth:30}},
    margin:{left:M, right:M}
  });

  // Footer pagina
  const pages = doc.internal.getNumberOfPages();
  for (let i=1;i<=pages;i++){
    doc.setPage(i);
    doc.setFontSize(8); doc.setTextColor(140,140,140);
    doc.text(`Proposta ${prop.versao}${prop.numero} · ${prop.dataEnvio||todayISO()}`, M, H-8);
    doc.text(`${i}/${pages}`, W-M, H-8, {align:'right'});
  }

  doc.save(`Prop. ${prop.versao}${prop.numero} ${prop.obraNome||''}.pdf`);
  toast('PDF gerado');
}

function pageHeader(doc, prop, M, RED){
  doc.setFontSize(9); doc.setTextColor(120,120,120);
  doc.text(`Cliente: ${prop.clienteNome||''}`, M, M+5);
  doc.text(`Obra: ${prop.numero} ${prop.obraNome||''}`, M, M+10);
  doc.text(`Local: ${prop.morada||''}`, M, M+15);
  doc.text(`Proposta: ${prop.versao}${prop.numero}`, M, M+20);
  doc.setDrawColor(...RED); doc.setLineWidth(0.4);
  doc.line(M, M+24, 210-M, M+24);
  doc.setTextColor(0,0,0);
}

function consolidarMateriais(prop){
  const map = new Map();
  const add = (m)=>{
    const k = `${m.descricao}|${m.unidade}`;
    const cur = map.get(k) || {descricao:m.descricao, unidade:m.unidade, qtdReal:0, totalCusto:0};
    cur.qtdReal += (m._qtdReal || (m.quantidade*(1+(m.desperdicio||0))));
    cur.totalCusto += (m._total || (cur.qtdReal * m.precoUn));
    cur.precoUn = m.precoUn;
    map.set(k, cur);
  };
  for (const c of prop.capitulos){
    for (const s of c.subcapitulos) for (const a of s.atividades) for (const m of a.materiais) add(m);
    for (const a of (c.atividadesDiretas||[])) for (const m of a.materiais) add(m);
  }
  const list = Array.from(map.values());
  list.forEach(m=> m.total = m.qtdReal * m.precoUn);
  list.sort((a,b)=>b.total - a.total);
  return list;
}

