      if (!d.equipas || !d.equipas.length) d.equipas = defaultEquipas();
      if (!d.unidades || !d.unidades.length) d.unidades = defaultUnidades();
      if (!d.config) d.config = defaultConfig();
      Store.data = d;
      return d;
    }
    // Legacy bootstrap (v0.1 / v0.2)
    const d = {
      clientes: [],
      propostas: [],
      bdAtividades: [],
      bdMateriais: [],
      equipas: defaultEquipas(),
      unidades: defaultUnidades(),
