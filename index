function countAtividades(prop){
  let n=0; for (const c of prop.capitulos){ n+=(c.atividadesDiretas||[]).length; for (const s of c.subcapitulos) n+=s.atividades.length; } return n;
}
function countMateriais(prop){
  let n=0; for (const c of prop.capitulos){
    for (const a of (c.atividadesDiretas||[])) n+=a.materiais.length;
    for (const s of c.subcapitulos) for (const a of s.atividades) n+=a.materiais.length;
  } return n;
}

